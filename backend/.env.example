# Copia este archivo a .env y completa los valores reales.
# .env nunca se sube a git (ver .gitignore).

# Puerto donde corre la API
PORT=5000

# Entorno: development | production | test
NODE_ENV=development

# Connection string de MongoDB Atlas (incluye el nombre de la base de datos, ej. /cafecito)
# Obtenlo desde Atlas > Database > Connect > Drivers
MONGODB_URI=mongodb+srv://<usuario>:<password>@<cluster>.mongodb.net/cafecito?retryWrites=true&w=majority&appName=Cafecito

# Origen permitido para CORS (URL del frontend)
CORS_ORIGIN=http://localhost:5173
