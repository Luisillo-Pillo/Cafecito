# Copia este archivo a .env y completa los valores reales.
# .env nunca se sube a git (ver .gitignore).

# Puerto donde corre la API
PORT=5000

# Entorno: development | production | test
NODE_ENV=development

# Connection string de MongoDB Atlas (incluye el nombre de la base de datos, ej. /cafecito)
# Obtenlo desde Atlas > Database > Connect > Drivers. También se acepta el nombre MONGODB_URI.
DB_CONNECTION_STRING=mongodb+srv://<usuario>:<password>@<cluster>.mongodb.net/cafecito?retryWrites=true&w=majority&appName=Cafecito

# Origen permitido para CORS (URL del frontend)
CORS_ORIGIN=http://localhost:5173

# Inicio de sesión del administrador (POST /api/auth/login).
# La contraseña nunca va en texto plano: genera el hash con
#   npm run hash-password --workspace=backend -- "<contraseña>"
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=
# Firma los tokens de sesión (8 h). Usa un valor largo y aleatorio; si falta, las sesiones se pierden al reiniciar.
AUTH_SECRET=

# Tokens fijos opcionales para "Authorization: Bearer <token>" (CI, Postman).
# ADMIN_TOKEN no tiene valor por default. VENDEDOR_TOKEN vale dev-vendedor-token fuera de producción.
ADMIN_TOKEN=
VENDEDOR_TOKEN=

# Solo para pruebas de integración (npm test): base de datos DESECHABLE.
# El nombre de la base debe terminar en _test; las pruebas borran sus colecciones.
# TEST_MONGODB_URI=mongodb://127.0.0.1:27017/cafecito_test
